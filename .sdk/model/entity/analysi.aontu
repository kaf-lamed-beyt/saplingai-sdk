# Entity: analysi

main: kit: entity: analysi: {

  alias: field: {}

  fields: {
    categories: {
      h: "Categories"
      n: "categories"
      r: false
      sh: "Categories to check."
      t: "`$ARRAY`"
    }
    characters: {
      h: "Characters"
      n: "characters"
      r: false
      t: "`$INTEGER`"
    }
    context: {
      h: "Context"
      n: "context"
      r: false
      sh: "Optional guidance (max 500 chars): what the texts are and how to decide borderline cases."
      t: "`$STRING`"
    }
    created: {
      h: "Created"
      n: "created"
      r: false
      t: "`$BOOLEAN`"
    }
    created_at: {
      h: "Created At"
      n: "created_at"
      r: false
      sh: "Naive ISO 8601 timestamp (UTC, no offset)."
      t: "`$STRING`"
    }
    fields: {
      h: "Fields"
      n: "fields"
      r: true
      sh: "The fields to extract (1-20): field names (<=50 chars), or {name, type, description (<=200 chars), required} objects."
      t: "`$ARRAY`"
      union: {
        branches: 2
        count: 1
        depth: 1
      }
    }
    key: {
      h: "Key"
      n: "key"
      r: false
      sh: "Sapling API key."
      t: "`$STRING`"
    }
    keywords: {
      h: "Keywords"
      n: "keywords"
      r: false
      sh: "Target keyword phrases, most important first (max 10)."
      t: "`$ARRAY`"
    }
    labels: {
      h: "Labels"
      n: "labels"
      r: true
      sh: "The candidate labels (2-20): label names (<=50 chars), or {name, description (<=200 chars)} objects."
      t: "`$ARRAY`"
      union: {
        branches: 2
        count: 1
        depth: 1
      }
    }
    lang: {
      h: "Lang"
      n: "lang"
      r: false
      sh: "ISO 639-1 language code of the text (default \"en\")."
      t: "`$STRING`"
    }
    multi_label: {
      h: "Multi Label"
      n: "multi_label"
      r: false
      sh: "true = several labels may apply at once (labels = those scoring >= threshold)."
      t: "`$BOOLEAN`"
    }
    name: {
      h: "Name"
      n: "name"
      op: {
        list: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      t: "`$STRING`"
    }
    neighbors: {
      h: "Neighbors"
      n: "neighbors"
      r: false
      sh: "[similarity, term] pairs."
      t: "`$ARRAY`"
    }
    query: {
      h: "Query"
      n: "query"
      r: true
      t: "`$STRING`"
    }
    results: {
      h: "Results"
      n: "results"
      r: false
      sh: "Present only for a batch (`texts`) request: one entry per input text, in input order, each shaped exactly like the single-text response."
      t: "`$ARRAY`"
    }
    return_usage: {
      h: "Return Usage"
      n: "return_usage"
      r: false
      sh: "When true, a successful JSON-object response additionally carries \"usage\": {\"characters\": <n>} — the billable character count this request submitted (0 for unbilled requests; the 2.5x adjustment for logographic languages is included, so CJ…"
      t: "`$BOOLEAN`"
    }
    rubric: {
      h: "Rubric"
      n: "rubric"
      r: false
      sh: "Also return the LLM rubric: overall + clarity/coherence/correctness/concision scores, summary and quoted issues with suggested rewrites (default false)."
      t: "`$BOOLEAN`"
    }
    rules: {
      h: "Rules"
      n: "rules"
      op: {
        create: {
          req: true
          type: "`$ARRAY`"
        }
      }
      r: false
      sh: "The style rules to enforce: 1-20 rules, each a rule name string (at most 80 characters) or a {name, description} object (description at most 400 characters adds nuance the model follows)."
      t: "`$ARRAY`"
      union: {
        branches: 2
        count: 1
        depth: 1
      }
    }
    ruleset: {
      h: "Ruleset"
      n: "ruleset"
      r: false
      sh: "The name of a saved ruleset (created via POST /api/v1/styleguide/rulesets) to check against in place of inline rules."
      t: "`$STRING`"
    }
    sentence_scores: {
      h: "Sentence Scores"
      n: "sentence_scores"
      r: false
      sh: "Also return a 1-5 score per sentence (default false)."
      t: "`$BOOLEAN`"
    }
    suggestions: {
      h: "Suggestions"
      n: "suggestions"
      r: false
      sh: "Generate titles/meta descriptions/slug/keywords with the LLM (default true)."
      t: "`$BOOLEAN`"
    }
    synonyms: {
      h: "Synonyms"
      n: "synonyms"
      r: false
      t: "`$ARRAY`"
    }
    text: {
      h: "Text"
      n: "text"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      r: false
      sh: "The text to process."
      t: "`$STRING`"
    }
    texts: {
      h: "Texts"
      n: "texts"
      r: false
      sh: "Batch form: 1 to 10 texts, each processed with the same options as a single request."
      t: "`$ARRAY`"
    }
    threshold: {
      h: "Threshold"
      n: "threshold"
      r: false
      sh: "Multi-label cut-off on the per-label score (default 0.5)."
      t: "`$NUMBER`"
    }
    updated_at: {
      h: "Updated At"
      n: "updated_at"
      r: false
      sh: "Naive ISO 8601 timestamp (UTC, no offset)."
      t: "`$STRING`"
    }
    usage: {
      h: "Usage"
      n: "usage"
      r: false
      sh: "Present only when the request sent return_usage: true."
      t: "`$OBJECT`"
    }
  }

  name: "analysi"
