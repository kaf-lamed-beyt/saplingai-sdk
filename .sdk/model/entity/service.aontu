# Entity: service

main: kit: entity: service: {

  alias: field: {}

  fields: {
    build: {
      h: "Build"
      n: "build"
      r: false
      t: "`$STRING`"
    }
    msg: {
      h: "Msg"
      n: "msg"
      r: false
      t: "`$STRING`"
    }
    version: {
      h: "Version"
      n: "version"
      r: false
      t: "`$STRING`"
    }
  }

  name: "service"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /api/v1/liveness"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/api/v1/liveness"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "liveness"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "GET /api/v1/version"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/api/v1/version"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "version"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
