# Entity: dictionary

main: kit: entity: dictionary: {

  alias: field: {}

  fields: {
    case_sensitive: {
      h: "Case Sensitive"
      n: "case_sensitive"
      r: false
      sh: "Whether matching is case sensitive."
      t: "`$BOOLEAN`"
    }
    created_at: {
      h: "Created At"
      n: "created_at"
      r: false
      sh: "RFC 1123 timestamp, e.g."
      t: "`$STRING`"
    }
    entry: {
      h: "Entry"
      n: "entry"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      r: false
      t: "`$STRING`"
    }
    id: {
      fo: "uuid"
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    key: {
      h: "Key"
      n: "key"
      r: false
      sh: "Sapling API key."
      t: "`$STRING`"
    }
    return_usage: {
      h: "Return Usage"
      n: "return_usage"
      r: false
      sh: "When true, a successful JSON-object response additionally carries \"usage\": {\"characters\": <n>} — the billable character count this request submitted (0 for unbilled requests; the 2.5x adjustment for logographic languages is included, so CJ…"
      t: "`$BOOLEAN`"
    }
    updated_at: {
      h: "Updated At"
      n: "updated_at"
      r: false
      sh: "RFC 1123 timestamp."
      t: "`$STRING`"
    }
    usage: {
      h: "Usage"
      n: "usage"
      r: false
      sh: "Present only when the request sent return_usage: true."
      t: "`$OBJECT`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "dictionary"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "case_sensitive"
            "entry"
            "key"
            "return_usage"
          ]
          co: {
            id: "POST /api/v1/dictionary"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/api/v1/dictionary"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "dictionary"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /api/v1/dictionary"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: false
                k: "query"
                n: "return_usage"
                or: "return_usage"
                r: false
                t: "`$BOOLEAN`"
              }
            ]
          }
          m: "GET"
          o: "/api/v1/dictionary"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "dictionary"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          co: {
            id: "DELETE /api/v1/dictionary/{entry_id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "entry_id"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                ex: false
                k: "query"
                n: "return_usage"
                or: "return_usage"
                r: false
                t: "`$BOOLEAN`"
              }
            ]
          }
          m: "DELETE"
          o: "/api/v1/dictionary/{entry_id}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              entry_id: "id"
            }
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "dictionary"
            }
            {
              var: "id"
            }
          ]
          t: {
