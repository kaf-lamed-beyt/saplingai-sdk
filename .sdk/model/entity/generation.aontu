# Entity: generation

main: kit: entity: generation: {

  alias: field: {}

  fields: {
    characters: {
      h: "Characters"
      n: "characters"
      r: false
      t: "`$INTEGER`"
    }
    context: {
      h: "Context"
      n: "context"
      r: true
      t: "`$OBJECT`"
    }
    formality: {
      h: "Formality"
      n: "formality"
      r: false
      sh: "Optional register: \"formal\" (vous/Sie/usted) or \"informal\" (tu/du/tú)."
      t: "`$STRING`"
    }
    key: {
      h: "Key"
      n: "key"
      r: false
      sh: "Sapling API key."
      t: "`$STRING`"
    }
    lang: {
      h: "Lang"
      n: "lang"
      r: false
      sh: "ISO 639-1 code used to pick the readability formula for the before/after scores and the billed language."
      t: "`$STRING`"
    }
    length: {
      h: "Length"
      n: "length"
      r: false
      sh: "Target summary size: \"short\" (1-2 sentences), \"medium\" (one paragraph, the default) or \"long\" (a few short paragraphs)."
      t: "`$STRING`"
    }
    mapping: {
      h: "Mapping"
      n: "mapping"
      r: false
      sh: "Transformation to apply."
      t: "`$STRING`"
    }
    num_results: {
      h: "Num Results"
      n: "num_results"
      r: false
      sh: "Number of alternatives to return (default 5)."
      t: "`$INTEGER`"
    }
    preserve_terms: {
      h: "Preserve Terms"
      n: "preserve_terms"
      r: false
      sh: "Terms the rewrite must keep exactly as written (product names, defined legal terms)."
      t: "`$ARRAY`"
    }
    query: {
      h: "Query"
      n: "query"
      r: true
      sh: "The partial text to continue, at most 200 characters."
      t: "`$STRING`"
    }
    reading_level: {
      h: "Reading Level"
      n: "reading_level"
      r: false
      sh: "Target audience: \"plain\" (plain-language style for a general audience, the default), \"elementary\" (~US grade 3-5), \"middle_school\" (~grade 6-8) or \"high_school\" (~grade 9-10)."
      t: "`$STRING`"
    }
    results: {
      h: "Results"
      n: "results"
      r: false
      sh: "Present only for a batch (`texts`) request: one entry per input text, in input order, each shaped exactly like the single-text response."
      t: "`$ARRAY`"
    }
    return_usage: {
      h: "Return Usage"
      n: "return_usage"
      r: false
      sh: "When true, a successful JSON-object response additionally carries \"usage\": {\"characters\": <n>} — the billable character count this request submitted (0 for unbilled requests; the 2.5x adjustment for logographic languages is included, so CJ…"
      t: "`$BOOLEAN`"
    }
    session_id: {
      h: "Session Id"
      n: "session_id"
      r: false
      sh: "Optional session identifier used to group feedback events."
      t: "`$STRING`"
    }
    source_lang: {
      h: "Source Lang"
      n: "source_lang"
      r: false
      sh: "Optional hint for the source language (same forms as target_lang)."
      t: "`$STRING`"
    }
    target_lang: {
      h: "Target Lang"
      n: "target_lang"
      r: true
      sh: "Language to translate into: ISO 639 code (\"fr\", \"zh-TW\") or English name (\"French\")."
      t: "`$STRING`"
    }
    tense_mapping: {
      h: "Tense Mapping"
      n: "tense_mapping"
      r: false
      sh: "Target tense."
      t: "`$STRING`"
    }
    text: {
      h: "Text"
      n: "text"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "The text to process."
      t: "`$STRING`"
    }
    texts: {
      h: "Texts"
      n: "texts"
      r: false
      sh: "Batch form: 1 to 10 texts, each processed with the same options as a single request."
      t: "`$ARRAY`"
    }
    tone_mapping: {
      h: "Tone Mapping"
      n: "tone_mapping"
      r: false
      sh: "Target tone."
      t: "`$STRING`"
    }
    usage: {
      h: "Usage"
      n: "usage"
      r: false
      sh: "Present only when the request sent return_usage: true."
      t: "`$OBJECT`"
    }
  }

  name: "generation"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
