# BasicDictionaryFlow

main: kit: flow: BasicDictionaryFlow:
{
  entity: "dictionary",
  kind: "basic",
  name: "BasicDictionaryFlow",
  step: [
    {
      i: {
        ref: "dictionary_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "dictionary_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "dictionary_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "dictionary01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "dictionary_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDictionaryFlow"
}